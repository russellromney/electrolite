{
  "name": "replay with offset >= 0 but no log_id returns 409 resync_required (F8)",
  "setup": "INSERT INTO todos (id, project_id, title, done) VALUES (1, 'p1', 'first', 0);",
  "operations": [
    { "kind": "GET", "path": "/electrolite/v1/projectTodos/p1", "query": "offset=-1" },
    {
      "kind": "GET",
      "path": "/electrolite/v1/projectTodos/p1",
      "query": "offset={prev[0].body.offset}"
    }
  ],
  "cross_engine": ["1.status", "1.body.error"],
  "expect": {
    "1.status": 409,
    "1.body.error": "resync_required"
  }
}
