{
  "name": "in-process predicate matcher returns same matched IDs across engines",
  "operations": [
    {
      "kind": "match_predicate",
      "predicate": { "type": "eq", "column": "project_id", "value": "p1" },
      "rows": [
        { "id": 1, "project_id": "p1", "title": "first", "done": 0 },
        { "id": 2, "project_id": "p2", "title": "second", "done": 0 },
        { "id": 3, "project_id": "p1", "title": "third", "done": 1 }
      ]
    },
    {
      "kind": "match_predicate",
      "predicate": { "type": "gt", "column": "id", "value": 1 },
      "rows": [
        { "id": 1, "project_id": "p1" },
        { "id": 2, "project_id": "p1" },
        { "id": 3, "project_id": "p2" }
      ]
    },
    {
      "kind": "match_predicate",
      "predicate": {
        "type": "and",
        "predicates": [
          { "type": "eq", "column": "project_id", "value": "p1" },
          { "type": "gt", "column": "id", "value": 1 }
        ]
      },
      "rows": [
        { "id": 1, "project_id": "p1" },
        { "id": 2, "project_id": "p1" },
        { "id": 3, "project_id": "p2" },
        { "id": 4, "project_id": "p1" }
      ]
    },
    {
      "kind": "match_predicate",
      "predicate": { "type": "in", "column": "project_id", "values": ["p1", "p3"] },
      "rows": [
        { "id": 1, "project_id": "p1" },
        { "id": 2, "project_id": "p2" },
        { "id": 3, "project_id": "p3" }
      ]
    }
  ],
  "cross_engine": [
    "0.body.matched_ids",
    "1.body.matched_ids",
    "2.body.matched_ids",
    "3.body.matched_ids"
  ]
}
