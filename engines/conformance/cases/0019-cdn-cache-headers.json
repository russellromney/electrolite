{
  "name": "CDN cache headers (etag, cache-control, vary) identical across engines",
  "operations": [
    {
      "kind": "GET",
      "path": "/electrolite/v1/projectTodos/p1",
      "query": "offset=-1"
    },
    {
      "kind": "GET",
      "path": "/electrolite/v1/projectTodos/p1",
      "query": "offset={prev[0].body.offset}&log_id={prev[0].body.log_id}&shape_handle={prev[0].body.shape_handle}"
    }
  ],
  "cross_engine": [
    "0.headers.etag",
    "0.headers.cache-control",
    "0.headers.vary",
    "1.headers.etag",
    "1.headers.cache-control",
    "1.headers.vary"
  ],
  "expect": {
    "0.headers.cache-control": "private, max-age=5",
    "1.headers.cache-control": "private, max-age=31536000, immutable"
  }
}
